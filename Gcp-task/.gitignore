# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Variable files containing secrets or environment-specific values
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration and local plans
.terraformrc
terraform.rc
*.tfplan
tfplan

# Google Cloud credentials
application_default_credentials.json
credentials.json
service-account*.json

# Terraform logs
*.log
apply.log

# Terraform provider lock file should be committed
# Keep .terraform.lock.hcl tracked